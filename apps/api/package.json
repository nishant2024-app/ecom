{
  "name": "@dairy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "job:cutoff": "tsx --env-file-if-exists=../../.env src/scripts/run-cutoff.ts",
    "spec": "tsx src/scripts/export-spec.ts"
  },
  "dependencies": {
    "@dairy/core": "workspace:*",
    "@dairy/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@scalar/fastify-api-reference": "^1.31.0",
    "@sinclair/typebox": "^0.34.37",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
