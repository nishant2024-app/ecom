# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local                     # local | staging | production
API_PORT=4000
LOG_LEVEL=info

# ── URLs ────────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
COOKIE_DOMAIN=localhost

# ── Data ────────────────────────────────────────────────
DATABASE_URL=postgres://app:app@localhost:5432/dairy
DATABASE_MIGRATOR_URL=postgres://migrator:migrator@localhost:5432/dairy
VALKEY_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────
# Web OAuth client ID from Google Cloud Console (also used as Android serverClientId)
GOOGLE_WEB_CLIENT_ID=
# JSON array of Ed25519 keys: [{"kid":"k1","privateKeyPem":"-----BEGIN PRIVATE KEY-----\n..."}]
# Generate with: pnpm --filter @dairy/api keys:generate
JWT_PRIVATE_KEYS=
# Accept locally signed Google tokens (tests/dev only; refused when APP_ENV=production)
AUTH_TEST_MODE=false

# ── First-time seed (pnpm db:seed runs only on an empty database) ──
SEED_OWNER_EMAIL=                 # your Google email: becomes the Owner in the admin
SEED_CATALOG=                     # demo (sample products + stock) | draft (sample products hidden, no stock) | none
SEED_STORE_NAME=
SEED_LEGAL_NAME=
SEED_FSSAI_NUMBER=
SEED_STORE_ADDRESS=                # registered address, shown on the policy and contact pages
SEED_SUPPORT_PHONE=
SEED_SUPPORT_EMAIL=

# ── Payments (Cashfree) ─────────────────────────────────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ── Storage (Cloudflare R2) ─────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
# Public URL of the media bucket (e.g. https://media.example.in). Locally the API serves /media itself.
R2_PUBLIC_BASE_URL=http://localhost:4000/media
# Without R2 settings (development only), uploads are stored in this folder
MEDIA_DIR=./var/media

# ── Maps and address lookup (docs/16-location-and-delivery.md) ──
GEOCODER_URL=https://nominatim.openstreetmap.org   # self-host Nominatim at scale, or "off"
GEOCODER_EMAIL=                                    # contact email required by Nominatim's usage policy
NEXT_PUBLIC_MAP_TILES_URL=                         # tile server; empty = OpenStreetMap public tiles (light use only)
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── Storefront (apps/web) ───────────────────────────────
SITE_URL=http://localhost:3000   # canonical URLs, sitemap, structured data
SITE_NAME=Mulshi Dairy
SITE_NOINDEX=false                    # true on staging so Google doesn't index it
API_INTERNAL_URL=http://localhost:4000

# ── Notifications ───────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="Dairy <orders@example.in>"

# ── Observability ───────────────────────────────────────
SENTRY_DSN=
