# Settings for LOCAL DEVELOPMENT. Copy to `.env` (scripts/local-setup.sh does this for you).
# Never commit `.env`. For a live server use `.env.production.example` instead (see DEPLOYMENT.md).
#
# Comments sit on their own lines on purpose: Docker's env_file does not strip trailing comments.
# Every variable below is read by the code; the full reference is in docs/12-development.md.

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=development
# local | staging | production. "production" turns on strict start-up checks and secure cookies.
APP_ENV=local
API_PORT=4000
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to false only in automated tests.
RATE_LIMIT_ENABLED=true

# ── Public addresses ────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Browser origins allowed to call the API (shop and admin), comma separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Cookie domain. In production use your parent domain with a leading dot, e.g. .example.in
COOKIE_DOMAIN=localhost

# ── Database and cache ──────────────────────────────────────────
# The API connects with the limited "app" role; migrations and the seed use the "migrator" role.
DATABASE_URL=postgres://app:app@localhost:5432/dairy
DATABASE_MIGRATOR_URL=postgres://migrator:migrator@localhost:5432/dairy
# Valkey or Redis. Used for rate limits and caches.
VALKEY_URL=redis://localhost:6379/0
# Integration tests (pnpm --filter @dairy/api test) use a separate database.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/dairy_test
TEST_DATABASE_MIGRATOR_URL=postgres://migrator:migrator@localhost:5432/dairy_test

# ── Sign-in (Google only) ───────────────────────────────────────
# Web OAuth client ID from Google Cloud Console (an Android app later uses the same ID as serverClientId).
GOOGLE_WEB_CLIENT_ID=
# JSON array of Ed25519 signing keys. Generate with: pnpm --filter @dairy/api keys:generate
# Required in production. In development the API makes a temporary key if this is empty.
JWT_PRIVATE_KEYS=
# Lets you sign in as a test customer without Google. Refused when APP_ENV=production.
AUTH_TEST_MODE=false

# ── First-time seed (pnpm db:seed only runs on an empty database) ──
# Your Google email: becomes the Owner account in the admin.
SEED_OWNER_EMAIL=
# demo (sample products + stock + sample coupon) | draft (sample products hidden, no stock) | none
SEED_CATALOG=demo
SEED_STORE_NAME=
SEED_LEGAL_NAME=
SEED_FSSAI_NUMBER=
# Registered address, shown on the policy and contact pages.
SEED_STORE_ADDRESS=
SEED_STATE=Maharashtra
SEED_SUPPORT_PHONE=
SEED_SUPPORT_EMAIL=

# ── Payments (Cashfree) ─────────────────────────────────────────
# Without keys, a fake "test payment" page is used (never in production).
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ── Product photos ──────────────────────────────────────────────
# Option A, recommended in production: Cloudflare R2. Fill in all four R2_ values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
# Public address of the photos. R2: your bucket's custom domain (https://media.example.in).
# Option B, photos on this server's disk (development, or a small single server): leave the four R2 values
# empty. Locally the API serves the folder below at /media. In production set this to https://api.example.in/media
R2_PUBLIC_BASE_URL=http://localhost:4000/media
MEDIA_DIR=./var/media

# ── Maps and address lookup (docs/16-location-and-delivery.md) ──
# Reverse geocoding for "use my location". A Nominatim-compatible URL, or "off".
GEOCODER_URL=https://nominatim.openstreetmap.org
# Contact email sent to the geocoder, as its usage policy asks.
GEOCODER_EMAIL=
# Map tiles. Empty = OpenStreetMap's public tiles (light use only). Set at build time of the shop.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── Storefront (apps/web) ───────────────────────────────────────
# Used for canonical URLs, the sitemap and structured data.
SITE_URL=http://localhost:3000
SITE_NAME=Mulshi Dairy
# true on a staging site, so Google does not index it.
SITE_NOINDEX=false
# Where the shop's server reaches the API (inside Docker: http://api:4000).
API_INTERNAL_URL=http://localhost:4000
# Used only if the store record has no legal details yet.
LEGAL_NAME=
LEGAL_ADDRESS=

# ── Admin panel (apps/admin, build time) ────────────────────────
# In development leave VITE_API_URL unset: the admin calls /api and Vite forwards it to API_PROXY_TARGET.
# In production the build bakes in the API address (docker compose passes PUBLIC_API_URL).
# VITE_API_URL=https://api.example.in
API_PROXY_TARGET=http://localhost:4000

# ── Order emails (docs/18-order-emails.md) ──────────────────────
# log (prints to the server log) | resend | brevo
EMAIL_PROVIDER=log
EMAIL_FROM="Mulshi Dairy <orders@example.in>"
RESEND_API_KEY=
BREVO_API_KEY=
