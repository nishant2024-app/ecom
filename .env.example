# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local                     # local | staging | production
API_PORT=4000
LOG_LEVEL=info

# ── URLs ────────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
COOKIE_DOMAIN=localhost

# ── Data ────────────────────────────────────────────────
DATABASE_URL=postgres://app:app@localhost:5432/dairy
DATABASE_MIGRATOR_URL=postgres://migrator:migrator@localhost:5432/dairy
VALKEY_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────
# Web OAuth client ID from Google Cloud Console (also used as Android serverClientId)
GOOGLE_WEB_CLIENT_ID=
# JSON array of Ed25519 keys: [{"kid":"k1","privateKeyPem":"-----BEGIN PRIVATE KEY-----\n..."}]
# Generate with: pnpm --filter @dairy/api keys:generate
JWT_PRIVATE_KEYS=
# Accept locally signed Google tokens (tests/dev only; refused when APP_ENV=production)
AUTH_TEST_MODE=false
SEED_OWNER_EMAIL=

# ── Payments (Cashfree) ─────────────────────────────────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ── Storage (Cloudflare R2) ─────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=dairy-media-local
R2_PUBLIC_BASE_URL=http://localhost:4000/media

# ── Notifications ───────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="Dairy <orders@example.in>"

# ── Observability ───────────────────────────────────────
SENTRY_DSN=
