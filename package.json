{
  "name": "dairy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @dairy/db generate",
    "db:migrate": "pnpm --filter @dairy/db migrate",
    "db:seed": "pnpm --filter @dairy/db seed",
    "docs:api": "redocly build-docs docs/api/openapi.json -o docs/api/reference.html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@redocly/cli": "1.34.24",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.34",
      "sharp": ">=0.35.5",
      "@faker-js/faker": ">=10.5.0"
    }
  }
}
