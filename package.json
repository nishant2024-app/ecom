{
  "name": "dairy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @dairy/db generate",
    "db:migrate": "pnpm --filter @dairy/db migrate",
    "db:seed": "pnpm --filter @dairy/db seed",
    "docs:api": "redocly build-docs docs/api/openapi.json -o docs/api/reference.html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@redocly/cli": "1.34.5",
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
