# Copy to /opt/dairy/.env on the server and fill in. Never commit the real file.
# Step-by-step: docs/17-deploy-single-server.md

# ── Database (choose two long random passwords) ─────────────────
POSTGRES_USER=migrator
POSTGRES_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
POSTGRES_DB=dairy
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DATABASE_MIGRATOR_URL=postgres://migrator:CHANGE_ME_MIGRATOR_PASSWORD@postgres:5432/dairy
DATABASE_URL=postgres://app:CHANGE_ME_APP_PASSWORD@postgres:5432/dairy
VALKEY_URL=redis://valkey:6379/0

# ── Site ────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
API_PORT=4000
LOG_LEVEL=info
PUBLIC_WEB_URL=https://example.in
PUBLIC_API_URL=https://api.example.in
CORS_ORIGINS=https://example.in,https://www.example.in,https://admin.example.in
COOKIE_DOMAIN=.example.in
SITE_URL=https://example.in
SITE_NAME=Your Brand
SITE_NOINDEX=false
AUTH_TEST_MODE=false

# ── Sign-in (Google) ────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
# pnpm --filter @dairy/api keys:generate  (paste the JSON on ONE line)
JWT_PRIVATE_KEYS=

# ── Payments (Cashfree) ─────────────────────────────────────────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ── Photos (Cloudflare R2) ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=dairy-media
R2_PUBLIC_BASE_URL=https://media.example.in

# ── Backups (a SEPARATE R2 bucket; same account keys are fine) ──
BACKUP_BUCKET=dairy-backups

# ── Cloudflare Tunnel ───────────────────────────────────────────
TUNNEL_TOKEN=

# ── First-time seed (runs once on an empty database) ────────────
SEED_OWNER_EMAIL=
SEED_CATALOG=draft
SEED_STORE_NAME=
SEED_LEGAL_NAME=
SEED_FSSAI_NUMBER=
SEED_STORE_ADDRESS=
SEED_SUPPORT_PHONE=
SEED_SUPPORT_EMAIL=

# ── Address lookup (see docs/16-location-and-delivery.md) ───────
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=

# ── Order emails (see docs/18-order-emails.md) ──────────────────
EMAIL_PROVIDER=log
EMAIL_FROM=Your Brand <orders@example.in>
RESEND_API_KEY=
BREVO_API_KEY=
