# Settings for a LIVE SERVER. Copy to /opt/dairy/.env on the server and fill in. Never commit the real file.
# Step by step: DEPLOYMENT.md. Every variable is explained in .env.example.
# Comments sit on their own lines: Docker's env_file does not strip trailing comments.
#
# Replace example.in with your domain everywhere.

# ── Database (choose two long random passwords: openssl rand -hex 24) ──
POSTGRES_USER=migrator
POSTGRES_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
POSTGRES_DB=dairy
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# Use the same passwords as above in these two lines.
DATABASE_MIGRATOR_URL=postgres://migrator:CHANGE_ME_MIGRATOR_PASSWORD@postgres:5432/dairy
DATABASE_URL=postgres://app:CHANGE_ME_APP_PASSWORD@postgres:5432/dairy
VALKEY_URL=redis://valkey:6379/0

# ── Site ────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
API_PORT=4000
LOG_LEVEL=info
PUBLIC_WEB_URL=https://example.in
PUBLIC_API_URL=https://api.example.in
CORS_ORIGINS=https://example.in,https://www.example.in,https://admin.example.in
COOKIE_DOMAIN=.example.in
SITE_URL=https://example.in
SITE_NAME=Your Brand
SITE_NOINDEX=false
AUTH_TEST_MODE=false

# ── Sign-in (Google) ────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
# Generate with: docker run --rm node:22-slim node -e "const c=require('crypto');const k=c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'});console.log('JWT_PRIVATE_KEYS='+JSON.stringify([{kid:'k1',privateKeyPem:k}]))"
# and paste the whole printed line here (it must stay on ONE line).
JWT_PRIVATE_KEYS=

# ── Payments (Cashfree) ─────────────────────────────────────────
# Stay on sandbox until Cashfree approves your account.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ── Product photos: choose ONE option ───────────────────────────
# Option A (recommended, survives server loss): Cloudflare R2. Fill in all of these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=dairy-media
R2_PUBLIC_BASE_URL=https://media.example.in
# Option B (no Cloudflare): leave the four R2_ values above empty and set
#   R2_PUBLIC_BASE_URL=https://api.example.in/media
# Photos are then stored in the Docker volume "media" on this server. Back that volume up too (scripts/backup.sh does).

# ── Backups (a SEPARATE R2 bucket; the same R2 keys are fine). Empty = keep backups on this server only ──
BACKUP_BUCKET=dairy-backups

# ── Optional: Cloudflare Tunnel instead of Nginx (docker compose --profile tunnel) ──
TUNNEL_TOKEN=

# ── First-time seed (runs once on an empty database) ────────────
# Your Google email: becomes the Owner account in the admin.
SEED_OWNER_EMAIL=
# draft = sample products hidden with no stock (edit them), none = start empty
SEED_CATALOG=draft
SEED_STORE_NAME=
SEED_LEGAL_NAME=
SEED_FSSAI_NUMBER=
SEED_STORE_ADDRESS=
SEED_STATE=Maharashtra
SEED_SUPPORT_PHONE=
SEED_SUPPORT_EMAIL=

# ── Address lookup (docs/16-location-and-delivery.md) ───────────
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=

# ── Order emails (docs/18-order-emails.md) ──────────────────────
# log | resend | brevo
EMAIL_PROVIDER=log
EMAIL_FROM=Your Brand <orders@example.in>
RESEND_API_KEY=
BREVO_API_KEY=
